# --- CORE ---
APP_ENV=development
APP_PORT=8080

# --- DATABASE (DEVELOPMENT / LOCAL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fabricspeaks

# --- DATABASE (PRODUCTION / SUPABASE) ---
# Use pooling port 6543 for DATABASE_URL
DATABASE_URL=postgresql://postgres:[password]@[host]:6543/postgres?sslmode=require
# Use direct port 5432 for DIRECT_URL (Migrations only)
DIRECT_URL=postgresql://postgres:[password]@[host]:5432/postgres?sslmode=require

# --- CACHE (DEVELOPMENT / LOCAL) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- CACHE (PRODUCTION / UPSTASH) ---
# Use rediss:// for TLS
REDIS_URL=rediss://default:[password]@[host]:6379

# --- AUTH & SECURITY ---
JWT_SECRET=super_secret_jwt_key_example

# --- THIRD-PARTY SERVICES ---
# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=

# SMS (MSG91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# --- GCP STORAGE ---
# Project ID
GOOGLE_CLOUD_PROJECT=fs-prod
# Storage Bucket for Images
GCS_MEDIA_BUCKET=fabric-speaks-media
# Path to service account key file for local development (relative to root)
# IMPORTANT: Never commit service-account.json to version control
GCS_CREDENTIALS=./service-account.json
